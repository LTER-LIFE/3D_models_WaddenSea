# syntax=docker/dockerfile:1

# Start from a stable Ubuntu LTS base image.
FROM ubuntu:22.04

# Metadata about who maintains this image.
LABEL maintainer="Qing Zhan"
# Short description shown by image-inspection tools.
LABEL description="Portable crosstool-NG and Jupyter environment for local Docker builds and Apptainer/Singularity use on HPC"

# Prevent apt from opening interactive prompts during build.
ENV DEBIAN_FRONTEND=noninteractive
# Set default timezone used during package install scripts.
ENV TZ=Etc/UTC
# Keep crosstool-NG version in one place for easier upgrades.
ENV CTNG_VERSION=1.26.0
# Installation location for crosstool-NG binaries and files.
ENV CTNG_PREFIX=/opt/crosstool-ng
# Put crosstool-NG and conda bins ahead of system PATH.
ENV PATH=/opt/crosstool-ng/bin:/opt/conda/bin:${PATH}
# Default Jupyter port used in config and runtime examples.
ENV JUPYTER_PORT=8889

# Install all system packages needed for:
# - building crosstool-NG and cross toolchains
# - running Python/Jupyter
# - running R and IRkernel
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Shell used for interactive and scripted workflows.
    bash \
    # Core C/C++ toolchain and common compile tools.
    build-essential \
    # crosstool-NG dependency: perfect hash function generator.
    gperf \
    # crosstool-NG dependency: parser generator.
    bison \
    # crosstool-NG dependency: lexical analyzer generator.
    flex \
    # Documentation/manpage toolchain support.
    texinfo \
    # Generates command help/man pages.
    help2man \
    # ncurses headers used by menuconfig style interfaces.
    libncurses5-dev \
    # Python runtime.
    python3 \
    # Python headers for compiled Python packages.
    python3-dev \
    # Python package installer.
    python3-pip \
    # Build system tools often required by source packages.
    autoconf \
    automake \
    libtool \
    libtool-bin \
    # Used by many configure scripts and makefiles.
    gawk \
    # Download tools for source archives and APIs.
    wget \
    curl \
    # TLS certificate bundle for HTTPS downloads.
    ca-certificates \
    # Version control utility.
    git \
    # Archive/compression tools needed by source tarballs.
    bzip2 \
    xz-utils \
    unzip \
    # Patching utility used by build systems.
    patch \
    # Efficient copy/sync utility.
    rsync \
    # Optional modern build toolchain.
    meson \
    ninja-build \
    # Helps discover library/compiler flags during builds.
    pkg-config \
    # Cross-platform build generator.
    cmake \
    # Explicit make install (already in build-essential, kept for clarity).
    make \
    # Identifies file types in scripts/tooling.
    file \
    # Locale data and locale generation tools.
    locales \
    # Tiny init process that forwards signals and reaps zombies.
    tini \
    # Base R runtime.
    r-base \
    # R/Python package native dependencies.
    libxml2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libgit2-dev \
    # Clean apt package index to reduce image size.
    && rm -rf /var/lib/apt/lists/*

# Generate UTF-8 locale so R/Python/Jupyter handle Unicode reliably.
RUN locale-gen en_US.UTF-8
# Export locale environment variables for all future layers.
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Download, compile, and install crosstool-NG from source.
RUN wget -q http://crosstool-ng.org/download/crosstool-ng/crosstool-ng-${CTNG_VERSION}.tar.bz2 \
    # Extract the compressed source archive.
    && tar -xjf crosstool-ng-${CTNG_VERSION}.tar.bz2 \
    # Enter source directory.
    && cd crosstool-ng-${CTNG_VERSION} \
    # Configure install path inside /opt.
    && ./configure --prefix=${CTNG_PREFIX} \
    # Build using all available CPU cores.
    && make -j"$(nproc)" \
    # Install binaries into CTNG_PREFIX.
    && make install \
    # Return to filesystem root before cleanup.
    && cd / \
    # Remove source/build artifacts to keep image smaller.
    && rm -rf crosstool-ng-${CTNG_VERSION} crosstool-ng-${CTNG_VERSION}.tar.bz2

# Upgrade Python packaging tools and install Jupyter stack.
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    # Install JupyterLab, classic notebook, and Python kernel.
    && python3 -m pip install --no-cache-dir \
    jupyterlab \
    notebook \
    ipykernel

# Install IRkernel in R so Jupyter can execute R notebooks.
RUN R -q -e "install.packages(c('IRkernel','remotes'), repos='https://cloud.r-project.org')" \
    # Register a system-wide R kernel spec inside the image.
    && R -q -e "IRkernel::installspec(user = FALSE, name = 'ir', displayname = 'R')"

# Prepare workspace and write a default Jupyter server config file.
RUN mkdir -p /work /opt/jupyter \
    # Write config lines to the target config file.
    && printf '%s\n' \
    # Listen on all interfaces inside container (needed for port mapping).
    'c.ServerApp.ip = "0.0.0.0"' \
    # Match the chosen Jupyter port.
    'c.ServerApp.port = 8889' \
    # Do not try to open a browser in container context.
    'c.ServerApp.open_browser = False' \
    # Allow client access through forwarded/tunneled connections.
    'c.ServerApp.allow_remote_access = True' \
    # Start Jupyter in /work by default.
    'c.ServerApp.root_dir = "/work"' \
    # Prefer /work in file browser.
    'c.ServerApp.preferred_dir = "/work"' \
    # Redirect output into the config file.
    > /opt/jupyter/jupyter_server_config.py

# Set default working directory for shell and commands.
WORKDIR /work

# Document the Jupyter port exposed by this image.
EXPOSE 8889

# Use tini as PID 1 to handle signals and child processes cleanly.
ENTRYPOINT ["/usr/bin/tini", "--"]
# Default command when no explicit command is provided.
CMD ["bash"]

# Build the Docker image with the following command:
# docker build -f Dockerfile.ctng-jupyter -t ctng-jupyter:1.26.0 .

# Quick local checks to verify crosstool-NG and Jupyter are working inside the container:
# docker run --rm ctng-jupyter:1.26.0 ct-ng version
# docker run --rm ctng-jupyter:1.26.0 python3 -m jupyter --version
# docker run --rm ctng-jupyter:1.26.0 R -q -e "IRkernel::installspec(user = FALSE, name = 'ir', displayname = 'R')"

# Run Jupyter locally
# docker run --rm -it -p 8889:8889 -v "${PWD}:/work" ctng-jupyter:1.26.0 \
# jupyter lab --config=/opt/jupyter/jupyter_server_config.py --allow-root

# Start Jupyter in the container with a fixed token
# docker run --rm -it -p 8889:8889 -v "${PWD}:/work" ctng-jupyter:1.26.0 \ 
# jupyter lab --ip=0.0.0.0 --port=8889 --no-browser --ServerApp.token=mytoken --ServerApp.root_dir=/work

# ----------------------------------------------------------------------
# Singularity workflow on cluster (using image already pushed to Docker Hub)
# ----------------------------------------------------------------------
# Load Singularity module (module name may vary by cluster).
# module load singularity

# Pull Docker image into a Singularity SIF file.
# singularity pull ctng-jupyter_1.26.0.sif docker://qingzfly/ctng-jupyter:1.26.0

# Open an interactive shell and bind your current project directory to /work.
# singularity shell --cleanenv --bind "$PWD:/work" --pwd /work ctng-jupyter_1.26.0.sif

# One-off command execution example.
# singularity exec --cleanenv ctng-jupyter_1.26.0.sif ct-ng version

# Start Jupyter inside Singularity with a fixed token.
# singularity exec --cleanenv --bind "$PWD:/work" --pwd /work ctng-jupyter_1.26.0.sif \
# jupyter lab --ip=0.0.0.0 --port=8889 --no-browser --ServerApp.token=mytoken --ServerApp.root_dir=/work

# If running on a remote cluster, create an SSH tunnel from your local machine:
# ssh -N -L 8889:127.0.0.1:8889 <user>@<cluster>

# Then connect VS Code to this server URL:
# http://127.0.0.1:8889/?token=mytoken